+  // PATCHED (Podium Notes): the stock implementation called application.open(url)
+  // (asynchronous) and then completeRequest() immediately in the same run-loop
+  // turn. That races the app switch against the share-session dismissal: the
+  // switch to the host app wins, the SOURCE app is backgrounded mid-handshake,
+  // and its share sheet never officially closes. Apple's apps clean up orphaned
+  // share sessions on return to foreground; third-party apps (Simplenote,
+  // Google Keep, ...) are left frozen until force-quit. Fix: sequence the two
+  // operations — completeRequest fires from open()'s completion handler, once
+  // the system has accepted the app switch — with a guarded fallback timer so
+  // the extension always completes even if the handler is never invoked.
+  private var didCompleteExtension = false
+
+  private func completeExtensionRequest() {
+    guard !didCompleteExtension else { return }
+    didCompleteExtension = true
+    extensionContext?.completeRequest(returningItems: [], completionHandler: nil)
+  }
+
