+  // PATCHED v2 (Podium Notes): the stock implementation raced application.open()
+  // against completeRequest() in the same run-loop turn. Patch v1 sequenced
+  // completeRequest into open()'s completion handler — but device logs showed
+  // the deeper problem: the app switch triggered by open() lands while the
+  // SOURCE app is still dismissing its share sheet and reporting the activity
+  // result (~1s in Simplenote/Google Keep). Suspending the source app mid-
+  // dismissal leaves an unfinished view-controller transition, and the app
+  // returns to foreground deaf to touch until force-quit. Apple's apps recover
+  // from interrupted teardown; many third-party apps do not.
+  //
+  // v2 therefore inverts the order: complete the request FIRST so the source
+  // app dismisses its sheet and finishes activity reporting while it is still
+  // frontmost, then perform the app switch after a delay. The extension is
+  // kept alive across the delay with performExpiringActivity, which exists
+  // for exactly this kind of short post-completion work.
+  private var didCompleteExtension = false
+
+  // How long the source app gets to finish share-sheet teardown before the
+  // app switch. Device logs showed Simplenote still reporting ~950ms after
+  // completion; tune here if needed.
+  private let redirectDelaySeconds: TimeInterval = 1.2
+
+  private func completeExtensionRequest() {
+    guard !didCompleteExtension else { return }
+    didCompleteExtension = true
+    extensionContext?.completeRequest(returningItems: [], completionHandler: nil)
+  }
+
